import java.util.Scanner; // Importa a classe Scanner para poder receber dados digitados pelo usuário.

public class Principal {
    public static void main(String[] args) {

      // Cria o Scanner para conseguir ler os números que o usuário digitar.
      Scanner scanner = new Scanner(System.in);

      // Pede para o usuário informar o primeiro número.
      System.out.print("Digite o primeiro número inteiro: ");

      // Guarda o primeiro número digitado dentro da variável "num".
      int num = scanner.nextInt();

      // Pede para o usuário informar o segundo número.
      System.out.print("Digite o segundo número inteiro: ");

      // Guarda o segundo número digitado dentro da variável "num2".
      int num2 = scanner.nextInt();

      // Soma os dois números e guarda o resultado na variável "soma".
      int soma = num + num2;

      // Mostra na tela o resultado da soma.
      System.out.println("A soma dos numéros são: " + soma);

      // Calcula a média dos dois números.
      // O "2.0" faz com que o resultado possa ter casas decimais.
      System.out.println("A sua média é: " + (soma / 2.0));  
    }
}
